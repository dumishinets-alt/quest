{
  "name": "promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "Kinetic typography promo: AI в освіті — запуск курсу",
  "scripts": {
    "studio": "remotion studio",
    "voice": "bash scripts/prepare_voice.sh",
    "still": "bash scripts/stills.sh",
    "render": "npm run render:landscape && npm run render:vertical && bash scripts/check_audio.sh",
    "typecheck": "tsc --noEmit",
    "render:landscape": "remotion render Promo out/promo-1920x1080.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac",
    "render:vertical": "remotion render PromoVertical out/promo-1080x1920.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac",
    "audio": "python3 scripts/generate_audio.py",
    "check-audio": "bash scripts/check_audio.sh",
    "narration": "python3 scripts/narration.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
